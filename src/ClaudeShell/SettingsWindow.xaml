<Window x:Class="ClaudeShell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Shell settings"
        Icon="Assets/icon.ico"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#9D9D9D" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent">
                            <TextBlock Text="&#x2715;"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3C3C3C" BorderThickness="1">
        <StackPanel>
            <Grid Background="#252526" Height="36" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="Claude Shell settings"
                           Foreground="#F0F0F0"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick" />
            </Grid>

            <StackPanel Margin="20">
                <TextBlock Text="Shortcut to open the popup" Foreground="#F0F0F0" Margin="0,0,0,6" />

                <TextBox x:Name="ShortcutBox"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Background="#2D2D2D"
                         Foreground="#F0F0F0"
                         BorderBrush="#3C3C3C"
                         Padding="8,6"
                         FontSize="16"
                         PreviewKeyDown="OnShortcutKeyDown" />

                <TextBlock Text="Click the box, then press the keys you want. Include Ctrl, Shift, Alt or Win."
                           Foreground="#9D9D9D"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock x:Name="ErrorText"
                           Foreground="#F48771"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="Collapsed" />

                <Grid Margin="0,20,0,0">
                    <Button Content="Open settings folder"
                            HorizontalAlignment="Left"
                            Padding="12,5"
                            Click="OnOpenFolder" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save" Width="80" Padding="0,5" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
                        <Button Content="Cancel" Width="80" Padding="0,5" IsCancel="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
